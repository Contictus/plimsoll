# Copy to .env and replace every value. .env is gitignored (L13).

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
PLIMSOLL_OWNER_PASSWORD=change-me-owner
PLIMSOLL_APP_PASSWORD=change-me-app

# Used from the host (tests, goose). Inside compose the services build their own DSN
# against host `postgres`.
PLIMSOLL_OWNER_DSN=postgres://plimsoll_owner:change-me-owner@localhost:5432/plimsoll?sslmode=disable
PLIMSOLL_APP_DSN=postgres://plimsoll_app:change-me-app@localhost:5432/plimsoll?sslmode=disable

# Master KEK for envelope encryption (K25). Base64, 32 bytes:
#   openssl rand -base64 32
# M0 only checks that it is present at startup, so a missing key fails fast rather than
# at the moment the first credential arrives in M2.
PLIMSOLL_MASTER_KEK=

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=plimsoll-api
