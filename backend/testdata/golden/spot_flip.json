{
  "name": "spot_flip",
  "why": "A sell larger than the position, then a partial close of the short it opened. Realizing on the whole fill instead of the closed quantity is the classic error, and it inflates PnL on a position that never existed.",
  "arithmetic": [
    "buy 1 @ 100          -> qty 1,   avg 100",
    "sell 4 @ 150         -> closed 1 (the whole long), realized (150 - 100) * 1 = 50",
    "                        NOT (150 - 100) * 4 = 200",
    "                        remaining 3 open SHORT at the trade price -> qty -3, avg 150",
    "buy 1 @ 120          -> closing 1 of the short: a short earns when price falls,",
    "                        realized (150 - 120) * 1 = 30, running total 80",
    "                        qty -2, avg stays 150"
  ],
