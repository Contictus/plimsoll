# K27: one origin for the UI and the API. There is no CORS configuration anywhere in this
# project because there is no cross-origin request to configure, and the session cookie is
# never reachable from JavaScript.
#
# handle_path strips the /api prefix, so the API's own routes stay clean: the router
# registers /healthz and /me, and the outside world reaches them at /api/healthz and
# /api/me. Path rewriting lives here rather than in Go so the process is identical whether
# it runs behind Caddy or bare in a test.
:8080 {
	handle_path /api/* {
		# Server-Sent Events must not be buffered: with the default buffering the first hint
		# reaches the browser when the connection closes, which is the moment it stops being
		# useful. flush_interval -1 passes bytes straight through (K51).
		#
		# The matcher runs after handle_path has stripped /api, which is why it matches
		# /stream/* and not /api/stream/*.
		@stream path /stream/*
		reverse_proxy @stream api:8000 {
			flush_interval -1
		}

		reverse_proxy api:8000
	}

	handle {
		respond "plimsoll: the dashboard arrives in M3" 200
	}
}
